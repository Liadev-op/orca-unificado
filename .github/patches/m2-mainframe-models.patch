+void MainFrame::ensure_models_tab()
+{
+    if (!wxGetApp().is_editor())
+        return;
+    if (!m_models_panel) {
+        m_models_panel = new WebModelsPanel(m_tabpanel);
+        m_models_panel->SetBackgroundColour(*wxWHITE);
+    }
+    int idx = m_tabpanel->FindPage(m_models_panel);
+    if (idx != wxNOT_FOUND)
+        m_tabpanel->RemovePage(idx);
+    m_models_panel->Show(false);
+    m_tabpanel->AddPage(m_models_panel, _L("Models"), std::string("tab_auxiliary_active"),
+                        std::string("tab_auxiliary_active"), false);
+}
