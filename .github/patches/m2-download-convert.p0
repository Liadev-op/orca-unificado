 wxString WebModelsPanel::SuggestDownloadPath(const std::string &provider_id, const wxString &uri, const wxString &suggested)
 {
-    ModelProvider *prov = nullptr;
-    for (auto &p : m_providers) {
-        if (p->id() == provider_id)
-            prov = p.get();
-    }
-    if (!prov)
+    try {
+        ModelProvider *prov = nullptr;
+        for (auto &p : m_providers) {
+            if (p->id() == provider_id)
+                prov = p.get();
+        }
+        if (!prov)
+            return {};
+        std::string page = m_hosts.count(provider_id) ? into_u8(m_hosts[provider_id]->CurrentUrl()) : "";
+        auto        sub  = prov->download_subfolder(page, into_u8(uri));
+        auto        dir  = models_provider_dir(provider_id, true) / sub;
+        boost::system::error_code ec;
+        boost::filesystem::create_directories(dir, ec);
+        wxFileName fn(suggested);
+        std::string name = sanitize_model_filename(into_u8(fn.GetFullName()));
+        if (name.empty() || name == "model") {
+            wxFileName fu(uri);
+            name = sanitize_model_filename(into_u8(fu.GetFullName()));
+        }
+        if (name.empty() || name.find('.') == std::string::npos)
+            name = "model.3mf";
+        // from_path uses wchar on Windows — FromUTF8(path.string()) was ACP and the file never landed.
+        return from_path(dir / name);
+    } catch (const std::exception &e) {
+        BOOST_LOG_TRIVIAL(error) << "Models SuggestDownloadPath: " << e.what();
+        return {};
+    } catch (...) {
         return {};
-    std::string page = m_hosts.count(provider_id) ? m_hosts[provider_id]->CurrentUrl().ToUTF8().data() : "";
-    auto        sub  = prov->download_subfolder(page, uri.ToUTF8().data());
-    auto        dir  = models_provider_dir(provider_id, true) / sub;
-    boost::system::error_code ec;
-    boost::filesystem::create_directories(dir, ec);
-    wxFileName fn(suggested);
-    std::string name = sanitize_model_filename(fn.GetFullName().ToUTF8().data());
-    if (name.empty() || name == "model") {
-        wxFileName fu(uri);
-        name = sanitize_model_filename(fu.GetFullName().ToUTF8().data());
     }
-    if (name.empty() || name.find('.') == std::string::npos)
-        name = "model.3mf";
-    return wxString::FromUTF8((dir / name).string());
 }
 
 void WebModelsPanel::OnDownloadFinished(const std::string &provider_id, const wxString &path)
 {
-    m_last_file      = path.ToUTF8().data();
-    m_last_converted.clear();
-    m_status->SetLabel(wxString::Format(_L("Saved to %s"), path));
-    BOOST_LOG_TRIVIAL(info) << "Models download: " << m_last_file << " provider=" << provider_id;
-    bool do_convert = m_chk_convert->GetValue();
-    ModelProvider *prov = nullptr;
-    for (auto &p : m_providers)
-        if (p->id() == provider_id)
-            prov = p.get();
-    if (do_convert && prov && prov->offers_u1_convert() && boost::algorithm::iends_with(m_last_file, ".3mf") &&
-        BambuToU1Converter::is_bambu_project(m_last_file)) {
-        std::string converted;
-        if (ConvertPath(m_last_file, &converted))
-            m_last_converted = converted;
+    try {
+        boost::system::error_code ec;
+        auto p = into_path(path);
+        if (!boost::filesystem::exists(p, ec) || !boost::filesystem::is_regular_file(p, ec)) {
+            auto scanned = newest_model_file(models_provider_dir(provider_id, false));
+            if (!scanned.empty() && boost::filesystem::exists(scanned, ec)) {
+                BOOST_LOG_TRIVIAL(warning) << "Models download path missing, using newest " << path_as_utf8(scanned);
+                p = scanned;
+            }
+        }
+        if (!boost::filesystem::exists(p, ec) || !boost::filesystem::is_regular_file(p, ec)) {
+            m_status->SetLabel(_L("Download reported a name but the file is not under models/. Use the site Download again, or Save to portable."));
+            WarningDialog(this,
+                          wxString::Format(_L("WebView2 finished a download named %s but the file is not on disk under models/. Click MakerWorld “Download STL/CAD” again. Files should land in:\n%s"),
+                                           path, from_path(models_provider_dir(provider_id, false))),
+                          _L("Models"), wxOK)
+                .ShowModal();
+            UpdateChrome();
+            return;
+        }
+        m_last_file = path_as_utf8(p);
+        m_last_converted.clear();
+        m_status->SetLabel(wxString::Format(_L("Saved to %s"), from_path(p)));
+        BOOST_LOG_TRIVIAL(info) << "Models download: " << m_last_file << " provider=" << provider_id;
+        bool do_convert = m_chk_convert->GetValue();
+        ModelProvider *prov = nullptr;
+        for (auto &pprov : m_providers)
+            if (pprov->id() == provider_id)
+                prov = pprov.get();
+        if (do_convert && prov && prov->offers_u1_convert() && boost::algorithm::iends_with(m_last_file, ".3mf") &&
+            BambuToU1Converter::is_bambu_project(p)) {
+            std::string converted;
+            if (ConvertPath(m_last_file, &converted))
+                m_last_converted = converted;
+        }
+    } catch (const std::exception &e) {
+        BOOST_LOG_TRIVIAL(error) << "Models OnDownloadFinished: " << e.what();
+        m_status->SetLabel(_L("Download handler failed. The app stayed open."));
+    } catch (...) {
+        BOOST_LOG_TRIVIAL(error) << "Models OnDownloadFinished: unknown";
+        m_status->SetLabel(_L("Download handler failed. The app stayed open."));
     }
     UpdateChrome();
 }
 
