std::string OrcaCloudServiceAgent::get_cloud_login_url(const std::string& language)
{
    std::string url = cloud_base_url + ORCA_CLOUD_LOGIN_PATH;
    if (!language.empty()) {
        url += "?lang=" + language;
    }
    return url;
}

