o) << "run wizard...";
            run_wizard(ConfigWizard::RR_DATA_EMPTY);
            BOOST_LOG_TRIVIAL(info) << "finished run wizard";

            return true;
        }

    if (isAgree.empty())
    {
        run_wizard(ConfigWizard::RR_DATA_EMPTY); // Compatible with older versions
        return true;
    }

    return false;
}

