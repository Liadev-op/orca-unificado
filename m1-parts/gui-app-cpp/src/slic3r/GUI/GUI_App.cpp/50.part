            wxCommandEvent* evt = new wxCommandEvent(EVT_REQUEST_SERVER_FAIL);
            wxString errorMsg   = wxString::Format(_L("request to server update soft fail with body:%s,error:%s,status:%d"), body,
                                                   error, http_status);
            evt->SetString(err