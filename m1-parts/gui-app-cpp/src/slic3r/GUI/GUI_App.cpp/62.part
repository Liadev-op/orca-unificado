        dlg.ShowModal();
        GLCanvas3D* canvas = this->plater_->get_current_canvas3D();
        if (canvas)
            canvas->force_set_focus();
        // BBS
        //app_layout_changed = dlg.settings_layout_changed();
#if ENABLE_GCODE_LINES_ID_IN_H_SLIDER
