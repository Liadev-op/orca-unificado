    wxMenu* editMenu = nullptr;
    if (m_plater != nullptr)
    {
        editMenu = new wxMenu();

    auto handle_key_event = [](wxKeyEvent& evt) {
        if (wxGetApp().imgui()->update_key_data(evt)) {
            GLCanvas3D* canvas = wxGetApp().plater()->get_current_canvas3D();
            if (canvas) {
                canvas->render();
                return true;
            }
        }
        return false;
    };
