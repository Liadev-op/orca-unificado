_btn}, m_slice_btn);
    };
    m_slice_btn->Bind(wxEVT_ENTER_WINDOW, try_show_slice_mode_popup);
    m_slice_option_btn->Bind(wxEVT_ENTER_WINDOW, try_show_slice_mode_popup);

    sizer->Layout();

