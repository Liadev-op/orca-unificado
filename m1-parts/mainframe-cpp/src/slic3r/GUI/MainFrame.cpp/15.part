    {
        auto        devices     = wxGetApp().app_config->get_devices();
        const auto& edit_preset = wxGetApp().preset_bundle->printers.get_edited_preset();

        auto printer_config    = wxGetApp().preset_bundle->printers.get_edited_preset().config;
