        bool is_snapmaker_u1   = false;
        if (printer_model_opt) {
            std::string printer_model = printer_model_opt->value;
            is_snapmaker_u1           = boost::icontains(printer_model, "Snapmaker") && boost::icontains(printer_model, "U1");
        }

        if (is_snapmaker_u1)
        {
            return true;
        }

        if (wxGetApp().app_c